  "history": {
    "daily_start": "2010-01-01",
    "intraday_start": "2020-01-01",
    "end": "current_date",
    "instrument_inception_if_later": true
  },
  "intervals": ["5min", "15min", "1h", "4h", "1day"],
  "request_window_days": {
    "5min": 10,
    "15min": 30,
    "1h": 180,
    "4h": 720,
    "1day": 5000
  },
  "storage": {
    "timestamp_timezone": "UTC",
    "preserve_provider_metadata": true,
    "retain_raw_response": true,
    "retain_normalized_bars": true,
    "content_addressed": true,
    "public_repository_data_permitted": false
  },
  "required_dataset_fields": [
    "provider",
    "symbol",
    "asset_class",
    "interval",
    "requested_start",
    "requested_end",
    "acquired_at",
    "row_count",
    "missing_bar_count",
    "configuration_sha256",
    "content_sha256"
