{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://athena.invalid/schemas/market-data-quota-reservation.schema.json",
  "title": "ATHENA Market Data Quota Reservation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "sequence",
    "reserved_at",
    "minute_bucket",
    "day_bucket",
    "manifest_sha256",
    "request_id",
    "credits",
    "previous_hash",
    "hash"
  ],
  "properties": {
    "sequence": {"type": "integer", "minimum": 1},
    "reserved_at": {"type": "string", "format": "date-time"},
    "minute_bucket": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}Z$"},
    "day_bucket": {"type": "string", "format": "date"},
    "manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "request_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "credits": {"const": 1},
    "previous_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
