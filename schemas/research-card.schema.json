{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://athena.invalid/schemas/research-card.schema.json",
  "title": "ATHENA Research Card",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "summary", "research_question", "method", "findings", "limitations", "assumptions", "counter_evidence", "claims", "hypotheses", "formulas"],
  "properties": {
    "version": {"type": "integer", "minimum": 1},
    "summary": {"type": "string", "minLength": 1},
    "research_question": {"type": "string", "minLength": 1},
    "method": {"type": "string", "minLength": 1},
    "findings": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "limitations": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "assumptions": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "counter_evidence": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "claims": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["claim_id", "statement", "relationship", "source_locator"],
        "properties": {
          "claim_id": {"type": "string", "minLength": 1},
          "statement": {"type": "string", "minLength": 1},
          "relationship": {"enum": ["supports", "contradicts", "context"]},
          "source_locator": {"type": "string", "minLength": 1}
        }
      }
    },
    "hypotheses": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["hypothesis_key", "version", "claim", "mechanism", "falsification", "claim_ids"],
        "properties": {
          "hypothesis_key": {"type": "string", "minLength": 1},
          "version": {"type": "integer", "minimum": 1},
          "claim": {"type": "string", "minLength": 1},
          "mechanism": {"type": "string", "minLength": 1},
          "falsification": {"type": "string", "minLength": 1},
          "claim_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
        }
      }
    },
    "formulas": {"type": "array", "minItems": 1, "items": {"$ref": "formula-extraction.schema.json"}}
  }
}
