{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://athena.invalid/schemas/historical-acquisition-manifest.schema.json",
  "title": "ATHENA Historical Acquisition Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "manifest_id",
    "manifest_sha256",
    "created_at",
    "policy_id",
    "resolution_id",
    "market_data_policy_sha256",
    "history_policy_sha256",
    "scope",
    "requested_end",
    "symbols",
    "intervals",
    "windows",
    "total_windows",
    "planned_api_credits",
    "decision_court_submission",
    "live_execution"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "manifest_id": {"type": "string", "pattern": "^ATH-HIST-[0-9A-F]{24}$"},
    "manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "created_at": {"type": "string", "format": "date-time"},
    "policy_id": {"const": "ATHENA-HIST-001"},
    "resolution_id": {"const": "ATHENA-MDR-001"},
    "market_data_policy_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "history_policy_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "scope": {"enum": ["FULL_APPROVED_HISTORY", "BOUNDED_APPROVED_SCOPE"]},
    "requested_end": {"type": "string", "format": "date"},
    "symbols": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "intervals": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "windows": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["request_id", "symbol", "interval", "start_date", "end_date", "api_credits"],
        "properties": {
          "request_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "symbol": {"type": "string"},
          "interval": {"type": "string"},
          "start_date": {"type": "string", "format": "date"},
          "end_date": {"type": "string", "format": "date"},
          "api_credits": {"const": 1}
        }
      }
    },
    "total_windows": {"type": "integer", "minimum": 1},
    "planned_api_credits": {"type": "integer", "minimum": 1},
    "decision_court_submission": {"const": "NOT_AUTHORIZED_BY_DATA_ACQUISITION"},
    "live_execution": {"const": "prohibited"}
  }
}
