{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://athena.invalid/schemas/historical-checkpoint.schema.json",
  "title": "ATHENA Historical Acquisition Checkpoint",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "sequence",
    "recorded_at",
    "manifest_sha256",
    "request_id",
    "symbol",
    "interval",
    "status",
    "result_status",
    "dataset_record_id",
    "quarantine_hash",
    "result_sha256",
    "previous_hash",
    "hash"
  ],
  "properties": {
    "sequence": {"type": "integer", "minimum": 1},
    "recorded_at": {"type": "string", "format": "date-time"},
    "manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "request_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "symbol": {"type": "string", "minLength": 1},
    "interval": {"type": "string", "minLength": 1},
    "status": {"enum": ["COMPLETED", "QUARANTINED"]},
    "result_status": {"enum": ["ACCEPTED", "DUPLICATE", "QUARANTINED"]},
    "dataset_record_id": {"type": ["string", "null"]},
    "quarantine_hash": {"type": ["string", "null"]},
    "result_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "previous_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
