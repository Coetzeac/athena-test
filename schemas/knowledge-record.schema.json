{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://athena.invalid/schemas/knowledge-record.schema.json",
  "title": "ATHENA Knowledge Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_id",
    "record_type",
    "title",
    "identity",
    "provenance",
    "evidence_ids",
    "related_record_ids",
    "content",
    "content_sha256",
    "recorded_at",
    "record_sha256"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "record_id": {"type": "string", "pattern": "^ATH-[A-Z]{3}-[0-9A-F]{24}$"},
    "record_type": {
      "enum": [
        "paper",
        "research_card",
        "hypothesis",
        "dataset",
        "experiment",
        "factor",
        "indicator",
        "strategy",
        "validation_result"
      ]
    },
    "title": {"type": "string", "minLength": 1},
    "identity": {"type": "object", "minProperties": 1},
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_type",
        "source_locator",
        "source_sha256",
        "observed_at",
        "acquisition_method",
        "usage_rights",
        "evidence_ids"
      ],
      "properties": {
        "source_type": {"type": "string", "minLength": 1},
        "source_locator": {"type": "string", "minLength": 1},
        "source_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "observed_at": {"type": "string", "format": "date-time"},
        "acquisition_method": {"type": "string", "minLength": 1},
        "usage_rights": {"type": "string", "minLength": 1},
        "evidence_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "evidence_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "related_record_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^ATH-[A-Z]{3}-[0-9A-F]{24}$"}
    },
    "content": {"type": "object"},
    "content_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "recorded_at": {"type": "string", "format": "date-time"},
    "record_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
